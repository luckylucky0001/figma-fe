<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Figma: Tag (Light variant only) -->
    <declare-styleable name="LegacyTagView">
        <attr name="tagTone" format="enum">
            <enum name="primary" value="0" />
            <enum name="success" value="1" />
            <enum name="warning" value="2" />
            <enum name="danger" value="3" />
        </attr>
    </declare-styleable>

    <!-- Figma: Cell -->
    <declare-styleable name="LegacyCellView">
        <attr name="cellTitle" format="string" />
        <attr name="cellValue" format="string" />
        <attr name="cellShowArrow" format="boolean" />
    </declare-styleable>

    <!-- Figma: Button -->
    <declare-styleable name="LegacyButton">
        <attr name="btnType" format="enum">
            <enum name="primary" value="0" />
            <enum name="default" value="1" />
            <enum name="text" value="2" />
        </attr>
        <attr name="btnSize" format="enum">
            <enum name="large" value="0" />
            <enum name="medium" value="1" />
            <enum name="small" value="2" />
        </attr>
    </declare-styleable>
</resources>
