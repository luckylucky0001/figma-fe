{
  "$description": "Figma Variables of 'Demo DS / Mobile', DTCG 2025.10 format (exported by figma-plugin or TokensBrücke)",
  "color": {
    "$type": "color",
    "primary":        { "$value": "#FF4D1A" },
    "primary-light":  { "$value": "#FFF1EB" },
    "success":        { "$value": "#00B578" },
    "success-light":  { "$value": "#E6F8F1" },
    "warning":        { "$value": "#FF8F1F" },
    "warning-light":  { "$value": "#FFF3E8" },
    "danger":         { "$value": "#F53F3F" },
    "danger-light":   { "$value": "#FFECE8" },
    "text-primary":   { "$value": "#1F2329" },
    "text-secondary": { "$value": "#646A73" },
    "text-tertiary":  { "$value": "#8F959E" },
    "bg-page":        { "$value": "#F5F6F7" },
    "bg-card":        { "$value": "#FFFFFF" },
    "bg-placeholder": { "$value": "#F2F3F5" },
    "border":         { "$value": "#E5E6EB" }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4,  "unit": "px" } },
    "sm": { "$value": { "value": 8,  "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "sm":   { "$value": { "value": 4,   "unit": "px" } },
    "md":   { "$value": { "value": 8,   "unit": "px" } },
    "lg":   { "$value": { "value": 12,  "unit": "px" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "font": {
    "$type": "typography",
    "title":    { "$value": { "fontFamily": "Noto Sans SC", "fontSize": { "value": 17, "unit": "px" }, "lineHeight": 1.4118, "fontWeight": 600 } },
    "subtitle": { "$value": { "fontFamily": "Noto Sans SC", "fontSize": { "value": 15, "unit": "px" }, "lineHeight": 1.4667, "fontWeight": 600 } },
    "body":     { "$value": { "fontFamily": "Noto Sans SC", "fontSize": { "value": 14, "unit": "px" }, "lineHeight": 1.4286, "fontWeight": 400 } },
    "caption":  { "$value": { "fontFamily": "Noto Sans SC", "fontSize": { "value": 12, "unit": "px" }, "lineHeight": 1.5,    "fontWeight": 400 } }
  }
}
